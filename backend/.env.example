# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── MySQL Database ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=central_of_digitalization

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string

# ── Power BI (Service Principal) ─────────────────────────────────────────────
POWERBI_TENANT_ID=your_azure_tenant_id
POWERBI_CLIENT_ID=your_azure_app_client_id
POWERBI_CLIENT_SECRET=your_azure_app_client_secret
POWERBI_MASTER_USERNAME=your_powerbi_master_account@domain.com
POWERBI_MASTER_PASSWORD=your_powerbi_master_password
POWERBI_WORKSPACE_ID=your_powerbi_workspace_id

# Power BI Report IDs
POWERBI_REPORT_SERVICE=your_report_id
POWERBI_REPORT_QUALITY=your_report_id
POWERBI_REPORT_COST=your_report_id
POWERBI_REPORT_SAFETY=your_report_id

# ── CODE AI (powered by Google Gemini) ───────────────────────────────────────
# UNIVERSAL KEY — shared fallback, used only when a user has NOT saved their own.
# Order of preference is always: personal key (BYOK) → universal key.
# That order matters: free-tier quota belongs to the KEY, so everyone on the
# universal key competes for one pool (500/day on the light tiers, 20/day deep).
# Leave empty to force every user to bring their own key.
CODE_AI_UNIVERSAL_KEY=
# Legacy name, still honoured if CODE_AI_UNIVERSAL_KEY is unset:
GEMINI_API_KEY=
# Verified callable on a fresh free-tier key (2026-07-31). The 2.5 family now
# returns 404 "no longer available to new users" and 2.0 has no free quota.
GEMINI_MODEL=gemini-3.6-flash

# Optional tuning
# GEMINI_TEMPERATURE=0.2
# GEMINI_MAX_OUTPUT_TOKENS=4096   # must also cover thinking tokens
# GEMINI_THINKING_LEVEL=low       # Gemini 3.x: low | high
# GEMINI_THINKING_BUDGET=0        # Gemini 2.5 only: token count, 0 disables
# GEMINI_TIMEOUT_MS=60000
# AI_RATE_MAX_REQUESTS=10         # per user, per window
# AI_RATE_WINDOW_SECONDS=60
# AI_HISTORY_TURNS=6              # previous Q&A pairs kept as chat memory
# AI_MAX_CONTEXT_CHARS=120000     # size cap of the dashboard data snapshot
# AI_MAX_KNOWLEDGE_CHARS=22000    # size cap of the injected domain knowledge
# AI_MAX_VISUALS=80               # cap on visuals per prompt (multi-page snapshots)
# JSON_BODY_LIMIT=10mb            # must fit the snapshot payload

# ── CODE AI tiers (Fase 2) ───────────────────────────────────────────────────
# Users never see these ids — the UI shows "CODE AI Cepat / Standar / Mendalam".
#
# Chosen from the ACTUAL free-tier limits (AI Studio, 2026-08-02):
#   gemini-3.6-flash        5 RPM /  20 RPD   ← scarce
#   gemini-3.5-flash        5 RPM /  20 RPD   ← scarce
#   gemini-3.5-flash-lite  15 RPM / 500 RPD
#   gemini-3.1-flash-lite  15 RPM / 500 RPD
# Quota is per MODEL, so cepat and standar deliberately use two DIFFERENT lite
# models: 500 + 500 = 1000 requests/day, leaving the 20/day flash allowance
# entirely for the deep tier.
AI_MODEL_CEPAT=gemini-3.1-flash-lite
AI_MODEL_STANDAR=gemini-3.5-flash-lite
AI_MODEL_MENDALAM=gemini-3.6-flash
# AI_THINKING_MENDALAM=high
# AI_ESCALATION=true              # one automatic retry at a higher tier when a
#                                 # cheap answer is clearly under-powered

# ── Row budget governor (Fase 1) ─────────────────────────────────────────────
# Tables larger than the threshold are sent as top/bottom rows + statistics
# computed over EVERY row. Measured: 20 visuals × 500 rows, 76k → ~13k tokens.
# AI_ROW_SUMMARY_THRESHOLD=25
# AI_ROW_SUMMARY_TOP=15
# AI_ROW_SUMMARY_BOTTOM=5
# AI_MAX_SAMPLE_ROWS=150          # total sample rows across all visuals
# AI_BUDGET_CEPAT=8000            # char budget per tier
# AI_BUDGET_STANDAR=18000
# AI_BUDGET_MENDALAM=40000

# ── Quota indicator (Fase 3) ─────────────────────────────────────────────────
# The API returns NO remaining-quota figure, so these are read from Google AI
# Studio by hand. Values below were verified there on 2026-08-02.
# A real 429 automatically tightens the effective limit and logs a warning.
AI_RPD_CEPAT=500
AI_RPM_CEPAT=15
AI_RPD_STANDAR=500
AI_RPM_STANDAR=15
AI_RPD_MENDALAM=20
AI_RPM_MENDALAM=5
AI_TPM=250000                     # tokens per MINUTE (there is no daily token cap)
AI_LIMITS_VERIFIED=true           # set false again if the plan changes
# AI_QUOTA_RESET_TZ=America/Los_Angeles   # Google resets at midnight PT (~15:00 WIB)

# ── Answer cache (Fase 5) ────────────────────────────────────────────────────
# Keyed by dashboard + normalized question + data fingerprint, so a slicer change
# never serves a stale answer.
# AI_CACHE=true
# AI_CACHE_TTL_CEPAT_MIN=360
# AI_CACHE_TTL_STANDAR_MIN=120
# AI_CACHE_TTL_MENDALAM_MIN=30
# AI_CACHE_MAX_ENTRIES=500
# AI_RETRY_DELAYS_MS=1000,2000,4000

# ── Data sanitization (what may leave the network) ───────────────────────────
# On the Gemini free tier Google may use prompts to improve their products, so
# identities are stripped before anything is sent. See README → Data sanitization.
AI_SANITIZE=true
# off       = send monetary values as-is
# relative  = send money columns as % of column total instead of absolute rupiah
AI_SANITIZE_MONEY=off
# Free-text columns (keterangan / root cause / saran) are scrubbed and capped
# AI_FREETEXT_MAX_CHARS=160
# Set to false to withhold the internal semantic-model knowledge pack entirely
AI_SEND_DOMAIN_KNOWLEDGE=true

# ── Email Notifications (Gmail SMTP) ─────────────────────────────────────────
EMAIL_FROM=your_gmail_address@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_16_chars
SUPERUSER_EMAIL=admin_email@yourdomain.com

# ── Public Backend URL (used in email approval links) ────────────────────────
# Local development:
BACKEND_URL=http://localhost:5000
# Production example:
# BACKEND_URL=https://api.yourdomain.com

# ── GLM-5.2 lewat NVIDIA NIM (provider CIA, opsional) ────────────────────────
# Endpointnya berformat OpenAI. Tanpa kunci ini, CIA tetap jalan memakai Gemini:
# modelRouter melewati GLM dan mencatat alasannya, bukan gagal.
NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=z-ai/glm-5.2
# Timeout eksplisit. Tanpa ini bot WhatsApp menggantung menunggu balasan.
# GLM_TIMEOUT_MS=30000
# Free tier sekitar 40 permintaan per menit. Angka di bawah ini sengaja lebih
# rendah, karena batas yang dipasang persis di angka resmi tetap kena 429.
# GLM_RATE_LIMIT_PER_MIN=35
# chat_template_kwargs tidak konsisten didukung endpoint ini. Default mati, dan
# kalau dinyalakan lalu ditolak, permintaannya diulang sekali tanpa parameter itu.
# GLM_ENABLE_THINKING=0

# CIA evidence platform rollout flags. Tetap false sampai smoke test selesai.
CIA_TELEMETRY_ENABLED=false
CIA_ADMIN_ANALYTICS_ENABLED=false
CIA_KPI_LIBRARY_ENABLED=false
CIA_ORCHESTRATOR_WEB_ENABLED=false
CIA_ORCHESTRATOR_WA_ENABLED=false
CIA_MULTI_SCHEDULE_ENABLED=false
CIA_MAX_RETRIEVAL_ROUNDS=4
CIA_DAX_REPAIR_LIMIT=1
CIA_DAX_MAX_ROWS=500
CIA_DAX_TIMEOUT_MS=45000
